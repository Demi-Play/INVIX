
# PG
POSTGRES_DB=invix_db
POSTGRES_USER=invix
POSTGRES_PASSWORD=invix_dev_password
# порт на хосте (5433, чтобы не конфликтовать с
# локальным PostgreSQL, у меня он по дефолту на 5432)
POSTGRES_PORT=5433

# minio
MINIO_ROOT_USER=invix_minio
MINIO_ROOT_PASSWORD=invix_minio_password
MINIO_BUCKET=invix
MINIO_REGION=us-east-1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# внутри docker backend ходит на minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_PRESIGN_EXPIRES_SECONDS=3600

# back
BACKEND_PORT=5000
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# PG_URL=postgresql+psycopg2://invix:invix_dev_password@localhost:5433/invix_db

# front
FRONTEND_PORT=3000
BACKEND_UPSTREAM=http://backend:5000

# tg bot
TELEGRAM_BOT_TOKEN=111111111
TELEGRAM_API_IP=149.154.166.110
# HTTPS-адрес мини-приложения для web_app кнопки.
# http подойдёт, бот покажет обычную ссылку, проверял уже)
MINI_APP_URL=http://localhost:3000
LOG_LEVEL=INFO
