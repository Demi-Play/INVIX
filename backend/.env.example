# локальный запуск docker compose эти же значения приходят из
# корневого env, так что это для отдельного запуска
DEBUG=true
HOST=0.0.0.0
PORT=5000

# postgre готовый URL имеет приоритет над PG_*
PG_URL=postgresql+psycopg2://postgres:password@localhost:5432/invix_db

# PostgreSQL по частям (используется, если PG_URL пустой)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=password
PG_DB=invix_db

# CORS: список origin'ов через запятую или *
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# minio
MINIO_ENDPOINT=localhost:9000
# адрес, доступный браузеру по нему подписываются presigned url
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=invix
MINIO_REGION=us-east-1
MINIO_SECURE=false
MINIO_PRESIGN_EXPIRES_SECONDS=3600
